"""The Spaces authority receiver: the Rust receiver behind PyO3. Every decision is Logos's checker's."""

import builtins
from collections.abc import Callable, Sequence

ARCHON_DOMAIN: str

class Value:
    """An Ontos value: an atom of bytes, or a tuple of values. Equality is structural."""

    @staticmethod
    def atom(data: bytes) -> Value: ...
    @staticmethod
    def tuple(items: Sequence[Value]) -> Value: ...
    @staticmethod
    def decode(data: bytes) -> Value:
        """Decodes canonical Ontos bytes; raises ValueError on malformed input."""
    def encode(self) -> bytes: ...
    @property
    def is_atom(self) -> bool: ...
    @property
    def bytes(self) -> bytes | None: ...
    @property
    def items(self) -> builtins.list[Value] | None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Query:
    """May `actor` assert `statement` in `space`?"""

    def __init__(self, actor: Value, space: Value, statement: Value) -> None: ...
    @property
    def actor(self) -> Value: ...
    @property
    def space(self) -> Value: ...
    @property
    def statement(self) -> Value: ...

class Bundle:
    """An authenticated space_facts output: untrusted until authentication and the proof pass."""

    def __init__(self, payload: bytes, authentication: Value) -> None: ...
    @property
    def payload(self) -> bytes: ...
    @property
    def authentication(self) -> Value: ...

class Decision:
    """`code` is one of the protocol's result codes; `detail` is diagnostic only."""

    @property
    def permitted(self) -> bool: ...
    @property
    def code(self) -> str: ...
    @property
    def detail(self) -> str: ...
    @property
    def checked_steps(self) -> int: ...

class SpaceFacts:
    @property
    def supplier(self) -> Value: ...
    @property
    def space(self) -> Value: ...
    @property
    def asserted_at(self) -> Value: ...
    @property
    def clauses(self) -> builtins.list[Value]: ...

class Verifier:
    """Checks supplied proofs under one configured root. No temporal policy, search, network or clock."""

    def __init__(self, root: Value, authenticate: Callable[[Bundle, Value], bool]) -> None:
        """Only the bool `True` authenticates: any other result is authentication-failed; an exception,
        invalid-proof. A KeyboardInterrupt or SystemExit raised by the adapter propagates from `verify`."""
    @staticmethod
    def archon(root: Value) -> Verifier:
        """A verifier with the built-in Archon adapter, which runs without calling back into Python."""
    def verify(self, query: Query, proof: bytes) -> Decision:
        """Checks `proof` for exactly `query`; any failure denies. Releases the GIL while checking."""

def archon_authenticate(bundle: Bundle, supplier: Value) -> bool: ...
def symbol(name: str) -> Value: ...
def fact(name: str, *args: Value) -> Value: ...
def list(items: Sequence[Value]) -> Value: ...
def path(*segments: str | bytes) -> Value: ...
def authorization(actor: Value, statement: Value, space: Value) -> Value: ...
def law_digest() -> bytes: ...
def layer_digest() -> bytes: ...
def decode_space_facts(payload: bytes) -> SpaceFacts: ...
